{
  "name": "Cuaderno",
  "short_name": "Cuaderno",
  "description": "Cuaderno digital con aspecto de papel electrónico: notas a mano, agenda, reuniones, biblioteca PDF, recortes y notas rápidas.",
  "lang": "es",
  "start_url": "./#/home",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#efeee9",
  "theme_color": "#efeee9",
  "share_target": {
    "action": "./compartir", "method": "POST", "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "fotos", "accept": ["image/*"] }] }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
